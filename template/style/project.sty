% ===========================================================================
%  Package options
% ---------------------------------------------------------------------------
%   final / draft       final (the default) is the version you hand in: no
%                       watermark and \todo{...} notes print nothing. draft
%                       adds a light DRAFT watermark behind the text, a footer
%                       with the compilation date, and shows the notes.
%
%   LOOK - paper / mono / colour
%                       paper (aliases: serious) has NO boxes at all: plain
%                       amsthm environments, bold run-in headings, italic
%                       statements, QED square, black and white - the standard
%                       layout of a mathematics or physics paper.
%                       mono (alias: bw) keeps the boxes but renders them in
%                       greys, colour (alias: color) gives every box type its
%                       own hue.
%                       Default: paper for the final version, colour while
%                       drafting. Naming a look explicitly always wins.
%                       Your content never changes - only the rendering.
%
%   indent / noindent   paragraph style. Default: indented paragraphs in the
%                       paper look, blank-line spacing otherwise.
%   biblatex / bibtex   bibliography backend. Default: biblatex + biber with
%                       author-only italic citations. "bibtex" falls back to
%                       natbib + bibtex and uses \projectbibliographystyle.
%   index / noindex     build the index of definitions. Default: index.
% ===========================================================================
\newif\ifproject@noindent  \project@noindenttrue
\newif\ifproject@biblatex  \project@biblatextrue
\newif\ifproject@index     \project@indextrue
\newif\ifproject@mono      \project@monofalse
\newif\ifproject@paper     \project@paperfalse
\newif\ifproject@draft     \project@draftfalse

% Tri-state, resolved after \ProcessOptions: auto | colour | mono | paper
\def\project@look{auto}
% Tri-state: auto | indent | noindent
\def\project@par{auto}

\DeclareOption{colour}{\def\project@look{colour}}
\DeclareOption{color}{\def\project@look{colour}}
\DeclareOption{mono}{\def\project@look{mono}}
\DeclareOption{bw}{\def\project@look{mono}}
\DeclareOption{paper}{\def\project@look{paper}}
\DeclareOption{serious}{\def\project@look{paper}}
\DeclareOption{indent}{\def\project@par{indent}}
\DeclareOption{noindent}{\def\project@par{noindent}}
\DeclareOption{biblatex}{\project@biblatextrue}
\DeclareOption{bibtex}{\project@biblatexfalse}
\DeclareOption{index}{\project@indextrue}
\DeclareOption{noindex}{\project@indexfalse}
\DeclareOption{draft}{\project@drafttrue}
\DeclareOption{final}{\project@draftfalse}
\ProcessOptions\relax

% --- resolve the look -------------------------------------------------------
\def\project@auto{auto}
\def\project@mono@{mono}
\def\project@paper@{paper}
\def\project@indent@{indent}

\ifx\project@look\project@auto
    \ifproject@draft
        \def\project@look{colour}
    \else
        \def\project@look{paper}
    \fi
\fi
% The paper look is black and white by definition, so it also selects the
% mono half of style/palette.tex (listings, index heading, hairlines).
\ifx\project@look\project@paper@ \project@papertrue \project@monotrue \fi
\ifx\project@look\project@mono@  \project@monotrue \fi

% --- resolve the paragraph style -------------------------------------------
\ifx\project@par\project@auto
    \ifproject@paper
        \def\project@par{indent}
    \else
        \def\project@par{noindent}
    \fi
\fi
\ifx\project@par\project@indent@ \project@noindentfalse \else \project@noindenttrue \fi

