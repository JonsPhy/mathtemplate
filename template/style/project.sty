% ===========================================================================
%  Bibliography
% ---------------------------------------------------------------------------
%  Default (biblatex + biber): in-text citations print the italic family name
%  only, without the year --- \cite{key} -> "Author",
%  \citep{key} -> "(Author)", \cite[Chapter~5]{key} adds a postnote.
%  With the [bibtex] option the classic natbib numeric style is used instead.
% ===========================================================================
\PassOptionsToPackage{hyphens}{url}
\usepackage{csquotes}   % recommended by biblatex when babel is loaded
\ifproject@biblatex
    \usepackage[
        style=authoryear-comp,
        sorting=nty,
        backend=biber,
        doi=true,
        url=true,
        isbn=false,
        maxnames=4,
        date=year,
        natbib=true
    ]{biblatex}
    % Suppress the year in in-text citations; show only the italic last name
    \renewbibmacro*{cite:labeldate+extradate}{}
    \DeclareNameFormat{lastonly}{\namepartfamily}
    \newcommand*{\mkbibparensit}[1]{\mkbibparens{\textit{#1}}}
    \DeclareCiteCommand{\parencite}[\mkbibparensit]
      {\usebibmacro{prenote}}
      {\usebibmacro{citeindex}\printnames[lastonly]{labelname}}
      {\multicitedelim}
      {\usebibmacro{postnote}}
    \DeclareCiteCommand{\cite}[\textit]
      {\usebibmacro{prenote}}
      {\usebibmacro{citeindex}\printnames[lastonly]{labelname}}
      {\multicitedelim}
      {\usebibmacro{postnote}}
    \DeclareCiteCommand{\textcite}
      {\usebibmacro{prenote}}
      {\usebibmacro{citeindex}\textit{\printnames[lastonly]{labelname}}}
      {\multicitedelim}
      {\usebibmacro{postnote}}
    % Make \citep and \citet go through the same custom commands
    \AtBeginDocument{%
      \let\citep\parencite
      \let\citet\textcite
    }
\else
    \usepackage[numbers,square]{natbib}
\fi
\usepackage{url}
\def\UrlBreaks{\do\/\do-\do\_\do\.}

