% ===========================================================================
%  Draft mode
% ---------------------------------------------------------------------------
%  [draft] puts a light "DRAFT" watermark behind the text, prints a footer
%  line with the compilation date, and shows \todo{...} notes. [final] (the
%  default) removes all of it, so the same source produces the print version.
%
%  \todo{...}            visible only in draft
%  \draftonly{...}       typeset only in draft
%  \finalonly{...}       typeset only in the final version
%  \projectwatermarktext redefine to change the watermark word
% ===========================================================================
\newcommand{\projectwatermarktext}{DRAFT}

\ifproject@draft
    \usepackage{eso-pic}
    \AddToShipoutPictureBG{%
        \AtTextCenter{%
            \makebox(0,0)[c]{%
                \rotatebox{45}{%
                    % Scaled to the text width, so any word fits on the page
                    \resizebox{1.05\textwidth}{!}{%
                        \color{projectwatermark}\sffamily\bfseries
                        \projectwatermarktext
                    }%
                }%
            }%
        }%
    }
    \fancyfoot[C]{\footnotesize\itshape\color{black!55}%
        \projectwatermarktext\ --- compiled \today}
    \NewDocumentCommand{\todo}{+m}{%
        {\normalfont\bfseries\color{projecttodo}[TODO: #1]}%
    }
    \NewDocumentCommand{\draftonly}{+m}{#1}
    \NewDocumentCommand{\finalonly}{+m}{}
\else
    \NewDocumentCommand{\todo}{+m}{}
    \NewDocumentCommand{\draftonly}{+m}{}
    \NewDocumentCommand{\finalonly}{+m}{#1}
\fi

