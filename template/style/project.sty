% ===========================================================================
%  Title page
% ===========================================================================
\newcommand{\makeprojecttitle}{
    \hypersetup{pageanchor=false}
    \begin{titlepage}
        \centering
        \vspace*{3.2cm}

        {\fontsize{26}{32}\selectfont\bfseries \projecttitle\par}
        \vspace{0.6cm}
        {\Large \projectsubtitle\par}

        \vspace{1.8cm}
        \projectlogobox{width=0.28\textwidth}\par

        \vspace{1.6cm}
        {\Large \projecttype\par}
        \vspace{0.8cm}
        {\large \projectdepartment\par}
        {\large \projectinstitution\par}

        \vfill

        {\large \textbf{Author:} \projectauthor\par}
        \vspace{0.3cm}
        {\large \textbf{Supervisor / Lecturer:} \projectsupervisor\par}
        \vspace{0.3cm}
        {\large \projectdate\par}
    \end{titlepage}
    \hypersetup{pageanchor=true}
}

% Header for a standalone exercise sheet (article class), see exercises/
\newcommand{\makesheettitle}[1]{
    \begin{center}
        {\LARGE\bfseries #1\par}
        \vspace{0.5em}
        {\color{projectrule}\rule{0.72\textwidth}{0.5pt}\par}
    \end{center}
}

% Epigraph at the start of a chapter. Spacing is stated positively so that it
% holds with and without \parskip.
\newcommand{\projectquote}[1]{
    \begin{center}
        {\large\itshape #1\par}
        \vspace{0.35em}
        {\color{projectrule}\rule{0.32\textwidth}{0.5pt}\par}
    \end{center}
}

% ===========================================================================
%  Back matter blocks
% ===========================================================================
\newcommand{\printprojectbibliography}{
    \cleardoublepage
    \ifproject@biblatex
        \printbibliography[heading=bibintoc]
    \else
        \addcontentsline{toc}{chapter}{Bibliography}
        \bibliographystyle{\projectbibliographystyle}
        \bibliography{\projectbibliographyfile}
    \fi

    \ifincludeauthordeclaration
        \cleardoublepage
        {\huge \textbf{\authordeclarationtitle}\par}
        \vspace{1.2cm}
        \authordeclarationtext\par
        \vspace{1.6cm}
        \projectauthor\hfill\projectdate\par
    \fi
}

\newcommand{\printprojectindex}{
    \ifproject@index
        \cleardoublepage
        \phantomsection
        \addcontentsline{toc}{chapter}{\indexname}
        \printindex
    \fi
}
